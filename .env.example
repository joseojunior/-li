# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=1200
WEB_APP_ORIGIN=http://localhost:5173
VITE_DEFAULT_ORGANIZATION_SLUG=lilibag-local

# Data services
DATABASE_URL=postgresql://lilibag:lilibag@localhost:5432/lilibag
REDIS_URL=redis://localhost:6379

# Security — generate distinct, long random values before any public deployment.
INBOUND_WEBHOOK_SECRET=replace-me-with-a-long-random-secret
ADMIN_API_KEY=replace-me-with-a-long-random-secret
AUTH_SESSION_TTL_DAYS=14

# Base64 of exactly 32 random bytes. Required only to save encrypted integration tokens.
DATA_ENCRYPTION_KEY=
APP_PUBLIC_URL=
WEBHOOK_PUBLIC_URL=
BLING_OAUTH_REDIRECT_URI=

# Media storage. Leave blank while storage is disabled; MinIO local or an S3-compatible service can be configured later.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PRESIGNED_URL_TTL_SECONDS=900

# Conversation processing
CONVERSATION_DEBOUNCE_MS=5000
CONVERSATION_LOCK_TTL_MS=45000

# Kept empty until the AI provider is intentionally enabled.
OPENAI_API_KEY=
OPENAI_MODEL=
