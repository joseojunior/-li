# Copy to deploy/.env.local-tunnel. Do not commit the copied file.
# This tunnel is only for local development.
# Use webhooks-dev for an isolated tunnel, or the three public hosts below
# only when they are not simultaneously routed to the VPS.
LOCAL_WEB_APP_ORIGIN=https://app.lilibag.online
LOCAL_API_PUBLIC_URL=https://api.lilibag.online
LOCAL_WEBHOOK_PUBLIC_URL=https://webhooks.lilibag.online
CLOUDFLARE_TUNNEL_TOKEN=PASTE_THE_REMOTELY_MANAGED_TUNNEL_TOKEN_HERE
