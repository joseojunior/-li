# Non-sensitive settings for docker stack deploy / Portainer Stack variables.
# Use uma tag imutÃ¡vel sha-... publicada pela GitHub Action.
LILIBAG_API_IMAGE=ghcr.io/joseojunior/lilibag-api:sha-replace-with-commit
LILIBAG_WEB_IMAGE=ghcr.io/joseojunior/lilibag-web:sha-replace-with-commit

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=1200
WEB_APP_ORIGIN=https://app.lilibag.online
APP_PUBLIC_URL=https://api.lilibag.online
WEBHOOK_PUBLIC_URL=https://webhooks.lilibag.online
AUTH_SESSION_TTL_DAYS=14

CONVERSATION_DEBOUNCE_MS=5000
CONVERSATION_LOCK_TTL_MS=45000
CONVERSATION_WORKER_CONCURRENCY=20
OUTBOUND_WORKER_CONCURRENCY=30
TRACE_WORKER_CONCURRENCY=50
