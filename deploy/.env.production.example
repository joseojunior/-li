# Copy to deploy/.env.production on the VPS. Never commit the copied file.
APP_DOMAIN=app.seudominio.com
ACME_EMAIL=infra@seudominio.com

NODE_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
API_BODY_LIMIT_BYTES=1048576
API_RATE_LIMIT_MAX=300
WEBHOOK_RATE_LIMIT_MAX=1200
WEB_APP_ORIGIN=https://app.seudominio.com
APP_PUBLIC_URL=https://app.seudominio.com
WEBHOOK_PUBLIC_URL=https://app.seudominio.com

POSTGRES_DB=lilibag
POSTGRES_USER=lilibag
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://lilibag:GENERATE_A_LONG_RANDOM_PASSWORD@postgres:5432/lilibag
REDIS_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:GENERATE_A_LONG_RANDOM_PASSWORD@redis:6379

INBOUND_WEBHOOK_SECRET=GENERATE_32_OR_MORE_RANDOM_BYTES
ADMIN_API_KEY=GENERATE_32_OR_MORE_RANDOM_BYTES
# Base64 of exactly 32 random bytes. Keep this value stable: it decrypts existing integration credentials.
DATA_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTE_KEY
AUTH_SESSION_TTL_DAYS=14

# Configure when Supabase Storage is created. Keep the bucket private.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PRESIGNED_URL_TTL_SECONDS=900

CONVERSATION_DEBOUNCE_MS=5000
CONVERSATION_LOCK_TTL_MS=45000
CONVERSATION_WORKER_CONCURRENCY=20
OUTBOUND_WORKER_CONCURRENCY=30
TRACE_WORKER_CONCURRENCY=50

# Keep empty until the provider is deliberately enabled through the panel.
OPENAI_API_KEY=
OPENAI_MODEL=
